{
    "name": "nexthon-language",
    "displayName": "NEXTHON Language",
    "description": "Language support for the NEXTHON programming language.",
    "version": "0.1.0",
    "publisher": "nexform",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "nexthon",
                "aliases": [
                    "NEXTHON",
                    "nexthon"
                ],
                "extensions": [
                    ".ne"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "nexthon",
                "scopeName": "source.nexthon",
                "path": "./syntaxes/nexthon.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "nexthon",
                "path": "./snippets/nexthon.json"
            }
        ]
    }
}