{
    "Variable": {
        "prefix": "var",
        "body": [
            "var ${1:name} = ${2:value}"
        ],
        "description": "Declare a variable"
    },
    "Constant": {
        "prefix": "const",
        "body": [
            "const ${1:NAME} = ${2:value}"
        ],
        "description": "Declare a constant"
    },
    "Function": {
        "prefix": "function",
        "body": [
            "function ${1:name}(${2:parameters}) {",
            "\t${3}",
            "}"
        ],
        "description": "Create a function"
    },
    "If / else": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "\t${2}",
            "} else {",
            "\t${3}",
            "}"
        ],
        "description": "Create an if/else block"
    },
    "While loop": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "\t${2}",
            "}"
        ],
        "description": "Create a while loop"
    },
    "For loop": {
        "prefix": "for",
        "body": [
            "for ${1:item} in ${2:items} {",
            "\t${3}",
            "}"
        ],
        "description": "Create a for loop"
    },
    "Try / except / finally": {
        "prefix": "try",
        "body": [
            "try {",
            "\t${1}",
            "} except error {",
            "\t${2}",
            "} finally {",
            "\t${3}",
            "}"
        ],
        "description": "Handle an error"
    },
    "Print": {
        "prefix": "print",
        "body": [
            "print(${1:value})"
        ],
        "description": "Print a value"
    }
}